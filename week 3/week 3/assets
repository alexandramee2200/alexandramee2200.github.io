<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, 
    initial-scale=1.0">

    <title>My Portfolio</title>

    <link rel="stylesheet" href="./styles.css">

</head>
<body>
     <header class="My Portfolio">
        <a class="logo" href="#home">My Portfolio</a>

        <nav>
            <a href="#about">About</a>
            <a href="#education">Education</a>
            <a href="#music">Music</a>
            <a href="#contact">Contact</a>
        </nav>

    </header>

    <main>
        
        <section class="hero" id="home">
         <p class="eyebrow">A little bit about me</p>
            <h1>
               
                Be the inspiration you wish to see in the world <br>
                
            </h1>

        <p class="hero-text">
             A collection of my inspirations and loves.</p>

        <a class="button-link" href="#about">
        Get to know me</a>

        </section>

         <section class="content-section" id="about">

            <div class="section-heading">
                <p class="eyebrow">The short version</p>
                <h2>A little sneak peek</h2>
            </div>

            <div class="cards">

                <article class="card">
                    <span class="card-number">01</span>

                    <h3>Vintage Clothing Curator</h3>

                    <p>I love vintage clothes, and I love making
                        people smile when they wear them. Finding
                        unique pieces and giving them a new life
                        is one of my favorite things.</p>
                </article>


                <article class="card">
                    <span class="card-number">02</span>

                    <h3>Barista</h3>

                    <p>
                        I make coffee, help people start their day,
                        and enjoy the little conversations that
                        come with working in a coffee shop.
                    </p>
                </article>


                <article class="card">
                    <span class="card-number">03</span>

                    <h3>Bunny Lover</h3>

                    <p>
                        I have the sweetest little baby boy named
                        Chewy! He is a Holland Lop and loves
                        head rubs.
                    </p>
                </article>

            </div>

        </section>


        <!-- Education Section -->
        <section class="content-section" id="education">

            <div class="section-heading">
                <p class="eyebrow">Always learning</p>
                <h2>Education History</h2>
            </div>

            <div class="education-card">

                <span class="year">2026</span>

                <div>
                    <h3>Arizona State University</h3>
                    <p>Undergraduate student</p>
                </div>

            </div>

        </section>


        <!-- Music Section -->
        <section class="content-section" id="music">

            <div class="section-heading">
                <p class="eyebrow">A little soundtrack</p>
                <h2>Favorite Kind of Music</h2>
            </div>

            <div class="music-card">

                <h3>Music is part of the creative process.</h3>

                <p>
                    I enjoy music that sets a mood, sparks inspiration,
                    and makes an ordinary day feel a little more interesting.
                </p>

                <p class="music-note">
                    Favorite artists and songs: Add your picks here!
                </p>

            </div>

        </section>

    </main>


    <!-- Contact Section -->
    <footer id="contact">

        <p class="eyebrow">Let's connect</p>

        <h2>Contact Information</h2>

        <p>
            Email:
